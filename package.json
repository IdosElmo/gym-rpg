{
  "name": "gym-rpg",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Gym RPG — אפליקציית אימונים אופליין (עברית/RTL) עם שכבת משחק",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
